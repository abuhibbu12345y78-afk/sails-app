# ---------------------------------------------------------------------------
# Browser-safe application settings
# Variables prefixed with NEXT_PUBLIC_ are bundled into client-side code.
# Never place secrets in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Server-only provider selection
# ---------------------------------------------------------------------------
DATABASE_PROVIDER=supabase
REALTIME_PROVIDER=supabase

# ---------------------------------------------------------------------------
# Server-only secrets and business configuration
# Never expose these through client components or NEXT_PUBLIC_ variables.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_REPORT_NUMBER=

# ---------------------------------------------------------------------------
# Server-only initial application context
# Resolve these from migrated database records. Do not invent identifiers.
# ---------------------------------------------------------------------------
APP_DEFAULT_TENANT_ID=
APP_DEFAULT_COMPANY_ID=
APP_DEFAULT_SALESMAN_ID=
APP_DEFAULT_USER_ID=
